# {{.ServiceName}} — monorepo 布局。
#
# 与独立仓库版的差别只有一处:proto 归根仓库统一管理,所以 buf 必须在
# 仓库根(../..)执行 —— buf 的 context directory 就是 buf.yaml 所在目录,
# 在服务目录里跑会报「path is outside context directory」。

VERSION ?= dev
GOIMAGE ?= golang:1.26.5-alpine3.22
GOOS ?= linux
GOARCH ?= arm64
CGOENABLED ?= 0

# SERVICE 取自目录名而非写死:目录改名后 Makefile 不用跟着改
SERVICE = $(shell basename $$PWD)

# 下面几项都是部署环境相关的,生成时填的是 co 的默认值,按需改
REPOSITORY ?= {{.DockerNamespace}}/$(SERVICE)
REGISTER ?= {{.DockerRegistry}}
ARM64 = linux/arm64
AMD64 = linux/amd64

# 服务注册用的 Consul(集群内域名)。配置不再走 Consul KV。
CONSUL_ADDR ?= {{.ConsulAddr}}

.PHONY: k8s-dev
k8s-dev:
	kubectl apply -f deploy

# 配置数据源二选一。Consul 只做服务注册/发现,与配置来源无关。
#   make dev      -> 本地 YAML,不接配置中心
#   make dev-cc   -> CONFIG_SOURCE_FILE 指向 Config Center selector
#
# 两种都只是「配置从哪来」,跟外部组件无关:postgres / redis 是启动硬依赖,
# 跑之前先在仓库根按 infrastructure/<组件>/compose.yaml 起好。

.PHONY: dev
dev:
	SERVICE_NAME="{{.ServiceName}}" \
	CONSUL_ENABLED=false \
	CONFIG_SOURCE=file \
	CONFIG_FILE=configs/dev.yml \
	go run cmd/server/main.go

# +co:begin config-configcenter
.PHONY: dev-cc
# 首次使用先复制 example,只在被忽略的 source.dev.yaml 里填机器 token:
#   cp configs/source.dev.yaml.example configs/source.dev.yaml
dev-cc:
	SERVICE_NAME="{{.ServiceName}}" \
	CONSUL_ENABLED=true \
	CONFIG_SOURCE_FILE=configs/source.dev.yaml \
	go run cmd/server/main.go
# +co:end

.PHONY: test
test:
	go test -short -coverprofile=coverage.out ./...

.PHONY: sqlc
sqlc:
	sqlc generate

# 只重新生成本服务自己的 proto。全量重生成用 --path api,
# 但那会连带改动别的服务的生成物,diff 里很难看出哪些是这次的改动。
.PHONY: api
api:
	cd ../.. && buf generate --template buf.gen.yaml --path api/{{.Name}}
	cd ../.. && buf generate --template buf.gen.ts.yaml --path api/{{.Name}}

.PHONY: generate
generate: api conf

.PHONY: conf
conf:
	cd ../.. && buf generate --template buf.gen.yaml --path services/{{.Name}}/internal/conf

.PHONY: docker-build
docker-build:
	@echo "构建的微服务: $(SERVICE)"
	@echo "系统: $(GOOS) | CPU架构: $(GOARCH)"
	@echo "镜像名: $(REPOSITORY):$(VERSION)"
	cd ../.. && docker build . \
	  -f ./services/$(SERVICE)/Dockerfile \
	  --progress=plain \
	  -t $(REPOSITORY):$(VERSION) \
	  --build-arg SERVICE=$(SERVICE) \
	  --build-arg CGOENABLED=$(CGOENABLED) \
	  --build-arg GOIMAGE=$(GOIMAGE) \
	  --build-arg GOOS=$(GOOS) \
	  --build-arg GOARCH=$(GOARCH) \
	  --build-arg VERSION=$(VERSION)

.PHONY: docker-push
docker-push:
	docker tag $(REPOSITORY):$(VERSION) $(REGISTER)/$(REPOSITORY):$(VERSION)
	docker push $(REGISTER)/$(REPOSITORY):$(VERSION)

.PHONY: docker-deploy
docker-deploy: docker-build docker-push

.PHONY: docker-deployx
docker-deployx:
	@echo "构建的微服务: $(SERVICE) | 平台: $(ARM64),$(AMD64)"
	cd ../.. && docker buildx build . \
	  -f ./services/$(SERVICE)/Dockerfile \
	  --progress=plain \
	  -t $(REGISTER)/$(REPOSITORY):$(VERSION) \
	  --build-arg SERVICE=$(SERVICE) \
	  --build-arg CGOENABLED=$(CGOENABLED) \
	  --build-arg GOIMAGE=$(GOIMAGE) \
	  --build-arg VERSION=$(VERSION) \
	  --platform $(ARM64),$(AMD64) \
	  --push \
	  --cache-from type=registry,ref=$(REGISTER)/$(REPOSITORY):cache \
	  --cache-to type=registry,ref=$(REGISTER)/$(REPOSITORY):cache,mode=max
