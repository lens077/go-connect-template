package data

import (
	"context"
	"errors"
	"fmt"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"
	"github.com/jackc/pgx/v5/pgtype"
	"{{.ServiceModule}}/internal/biz"
	"{{.ServiceModule}}/internal/data/models"
	"{{.ServiceModule}}/internal/pkg/money"
	"go.uber.org/zap"
)

// 编译期断言:接口签名改了这里立刻报错,而不是等到 fx 在运行时装配失败
var _ biz.{{.Pascal}}Repo = (*{{.Camel}}Repo)(nil)

type {{.Camel}}Repo struct {
	data *Data
	log  *zap.Logger
}

func New{{.Pascal}}Repo(data *Data, logger *zap.Logger) biz.{{.Pascal}}Repo {
	return &{{.Camel}}Repo{data: data, log: logger}
}

// queries 每次从 ctx 现取句柄:在 ExecTx 里就绑事务,否则绑连接池。
// 不在构造时固定成 models.New(pool),那样事务里的写入会走到池上,
// 与外层事务不在同一个连接,回滚也回滚不掉。
func (r *{{.Camel}}Repo) queries(ctx context.Context) *models.Queries {
	return models.New(r.data.DB(ctx))
}

func (r *{{.Camel}}Repo) Create(ctx context.Context, p biz.Create{{.Pascal}}Params) (*biz.{{.Pascal}}, error) {
	price, err := money.Float64ToNumeric(p.Price)
	if err != nil {
		return nil, fmt.Errorf("invalid price: %w", err)
	}

	m, err := r.queries(ctx).Create{{.Pascal}}(ctx, models.Create{{.Pascal}}Params{
		Code:         p.Code,
		Name:         p.Name,
		Description:  p.Description,
		Price:        price,
		Status:       p.Status,
		MainMediaKey: p.MainMediaKey,
		Quantity:     p.Quantity,
	})
	if err != nil {
		// 23505 = unique_violation,对应 code 的部分唯一索引
		var pgErr *pgconn.PgError
		if errors.As(err, &pgErr) && pgErr.Code == "23505" {
			return nil, biz.Err{{.Pascal}}AlreadyExists
		}
		return nil, err
	}
	return to{{.Pascal}}(m)
}

func (r *{{.Camel}}Repo) Get(ctx context.Context, id int64) (*biz.{{.Pascal}}, error) {
	m, err := r.queries(ctx).Get{{.Pascal}}(ctx, id)
	if err != nil {
		// 把存储层的 ErrNoRows 翻译成领域错误:biz 与 service 都不该认识 pgx
		if errors.Is(err, pgx.ErrNoRows) {
			return nil, biz.Err{{.Pascal}}NotFound
		}
		return nil, err
	}
	return to{{.Pascal}}(m)
}

func (r *{{.Camel}}Repo) List(ctx context.Context, p biz.List{{.Pascal}}Params) (*biz.List{{.Pascal}}Result, error) {
	q := r.queries(ctx)

	cursor := pgtype.Timestamptz{}
	if p.CursorCreatedAt != nil {
		cursor = pgtype.Timestamptz{Time: *p.CursorCreatedAt, Valid: true}
	}

	rows, err := q.List{{.PascalPlural}}(ctx, models.List{{.PascalPlural}}Params{
		Status:          p.Status,
		CursorCreatedAt: cursor,
		CursorID:        p.CursorID,
		PageSize:        p.PageSize,
	})
	if err != nil {
		return nil, err
	}

	// Count 与 List 是两条独立查询,并发写入下总数与当前页可能对不上一行两行。
	// 分页展示这点偏差可以接受;要严格一致就把两条查询放进同一个 ExecTx。
	total, err := q.Count{{.PascalPlural}}(ctx, p.Status)
	if err != nil {
		return nil, err
	}

	items := make([]biz.{{.Pascal}}, 0, len(rows))
	for _, m := range rows {
		item, err := to{{.Pascal}}(m)
		if err != nil {
			return nil, err
		}
		items = append(items, *item)
	}

	return &biz.List{{.Pascal}}Result{Items: items, Total: total}, nil
}

func (r *{{.Camel}}Repo) Update(ctx context.Context, p biz.Update{{.Pascal}}Params) (*biz.{{.Pascal}}, error) {
	// price 为 nil 时传零值 Numeric(Valid=false),SQL 里的 COALESCE 会保留原值
	var price pgtype.Numeric
	if p.Price != nil {
		converted, err := money.Float64ToNumeric(*p.Price)
		if err != nil {
			return nil, fmt.Errorf("invalid price: %w", err)
		}
		price = converted
	}

	m, err := r.queries(ctx).Update{{.Pascal}}(ctx, models.Update{{.Pascal}}Params{
		ID:           p.ID,
		Name:         p.Name,
		Description:  p.Description,
		Price:        price,
		Status:       p.Status,
		MainMediaKey: p.MainMediaKey,
		Quantity:     p.Quantity,
	})
	if err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return nil, biz.Err{{.Pascal}}NotFound
		}
		return nil, err
	}
	return to{{.Pascal}}(m)
}

func (r *{{.Camel}}Repo) Delete(ctx context.Context, id int64) (bool, error) {
	// :execrows 而非 :exec —— 调用方据此区分「删掉了」和「本来就不存在」
	affected, err := r.queries(ctx).SoftDelete{{.Pascal}}(ctx, id)
	if err != nil {
		return false, err
	}
	return affected > 0, nil
}

// to{{.Pascal}} 把 sqlc 生成的行结构转成领域对象。
// 只有这一个函数认识 pgtype,biz 层拿到的全是 Go 原生类型。
func to{{.Pascal}}(m models.{{.Pascal}}) (*biz.{{.Pascal}}, error) {
	price, err := money.NumericToFloat(m.Price)
	if err != nil {
		return nil, fmt.Errorf("{{.Name}} %d: %w", m.ID, err)
	}

	return &biz.{{.Pascal}}{
		ID:           m.ID,
		Code:         m.Code,
		Name:         m.Name,
		Description:  m.Description,
		Price:        price,
		Status:       m.Status,
		MainMediaKey: m.MainMediaKey,
		Quantity:     m.Quantity,
		CreatedAt:    m.CreatedAt,
		UpdatedAt:    m.UpdatedAt,
	}, nil
}
