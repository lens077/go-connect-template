-- {{.Table}} 表。sqlc 靠这份 DDL 推断 queries/{{.Table}}.sql 里每个字段的类型,
-- 所以它必须与真实库结构一致 —— 改了迁移就要同步改这里,否则生成的 Go 类型是错的。
--
-- 文件名的 000N_ 前缀决定读取顺序,与迁移工具的命名保持一致。

-- +goose Up
CREATE TABLE IF NOT EXISTS {{.Table}}
(
    id             BIGSERIAL PRIMARY KEY,
    -- 业务主键。对外暴露它而不是自增 id,避免泄露数据量、也便于跨库迁移
    code           TEXT           NOT NULL,
    name           TEXT           NOT NULL,
    description    TEXT           NOT NULL DEFAULT '',
    -- 金额一律 NUMERIC,不用 double precision:
    -- 浮点存不下 0.1 这类十进制小数,累加几次就会出现分位误差
    price          NUMERIC(12, 2) NOT NULL,
    status         TEXT           NOT NULL DEFAULT 'draft',
    -- 只存对象存储的相对 key,域名放配置(见 internal/pkg/minio.go),
    -- 换 CDN 时改一处配置即可,不用刷全表
    main_media_key TEXT           NOT NULL DEFAULT '',
    quantity       BIGINT         NOT NULL DEFAULT 0,
    created_at     TIMESTAMPTZ    NOT NULL DEFAULT now(),
    updated_at     TIMESTAMPTZ    NOT NULL DEFAULT now(),
    -- 软删除:置位而非物理删除,便于审计与恢复
    deleted_at     TIMESTAMPTZ
);

-- 带 deleted_at IS NULL 的部分唯一索引:同一个 code 被软删后还能重新建。
-- 普通唯一索引会把已删除的行也算进去,导致「删了却建不回来」。
CREATE UNIQUE INDEX IF NOT EXISTS {{.Table}}_code_key
    ON {{.Table}} (code) WHERE deleted_at IS NULL;

-- 覆盖 ListXxx 的过滤 + 排序:(status, created_at DESC) 让 keyset 分页走索引扫描
CREATE INDEX IF NOT EXISTS {{.Table}}_status_created_at_idx
    ON {{.Table}} (status, created_at DESC) WHERE deleted_at IS NULL;

-- +goose Down
DROP TABLE IF EXISTS {{.Table}};
